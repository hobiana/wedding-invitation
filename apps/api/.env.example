# Production deployment (Railway/Render): DATABASE_URL, JWT_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL, ALLOWED_ADMIN_EMAILS, and FRONTEND_URL
# must be set as environment variables in the Railway/Render project settings —
# this .env.example is for local development only and is not read in production.
#
# These are validated at boot by src/config/env.validation.ts:
#   - DATABASE_URL and JWT_SECRET are REQUIRED in every environment. There is no
#     fallback secret; the app refuses to start without them.
#   - FRONTEND_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL and
#     ALLOWED_ADMIN_EMAILS are REQUIRED when NODE_ENV=production, and optional in
#     development (Google OAuth simply won't work until you fill them in).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_app"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
ALLOWED_ADMIN_EMAILS=""
# Also the origin allowed by CORS. In production the frontend lives on a different
# domain than the API, which is why the auth cookie is SameSite=None + Secure there.
FRONTEND_URL="http://localhost:5173"
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
