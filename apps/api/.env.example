# Production deployment (Railway/Render): DATABASE_URL, JWT_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL, ALLOWED_ADMIN_EMAILS, and FRONTEND_URL
# must be set as environment variables in the Railway/Render project settings —
# this .env.example is for local development only and is not read in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_app"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
ALLOWED_ADMIN_EMAILS=""
FRONTEND_URL="http://localhost:5173"
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
